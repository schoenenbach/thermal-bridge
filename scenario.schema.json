{
  "$defs": {
    "BoundaryConditions": {
      "description": "Boundary conditions for the simulation.",
      "properties": {
        "dirichlet": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Fixed temperature BCs",
          "title": "Dirichlet",
          "type": "object"
        },
        "adiabatic": {
          "description": "Adiabatic boundary names",
          "items": {
            "type": "string"
          },
          "title": "Adiabatic",
          "type": "array"
        },
        "convective": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConvectiveBCParams"
              },
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              }
            ]
          },
          "description": "Convective BCs per side (internal, external, etc.)",
          "title": "Convective",
          "type": "object"
        },
        "surface_resistance": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Surface resistance overrides by material ID (can be int or string)",
          "title": "Surface Resistance",
          "type": "object"
        }
      },
      "title": "BoundaryConditions",
      "type": "object"
    },
    "CanvasConfig": {
      "description": "Simulation canvas settings.",
      "properties": {
        "bounds": {
          "description": "[x_min, x_max, y_min, y_max]",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bounds",
          "type": "array"
        },
        "grid": {
          "description": "Grid resolution in mm",
          "exclusiveMinimum": 0,
          "title": "Grid",
          "type": "number"
        }
      },
      "required": [
        "bounds",
        "grid"
      ],
      "title": "CanvasConfig",
      "type": "object"
    },
    "ComponentDefinition": {
      "description": "Template for a reusable group of elements.",
      "properties": {
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/ElementBase"
          },
          "title": "Elements",
          "type": "array"
        }
      },
      "title": "ComponentDefinition",
      "type": "object"
    },
    "ConvectiveBCParams": {
      "description": "Convective boundary condition parameters.",
      "properties": {
        "T": {
          "default": 20.0,
          "description": "Temperature in Celsius",
          "title": "T",
          "type": "number"
        },
        "R": {
          "default": 0.13,
          "description": "Thermal resistance in m\u00b2K/W",
          "title": "R",
          "type": "number"
        }
      },
      "title": "ConvectiveBCParams",
      "type": "object"
    },
    "DerivedMetric": {
      "description": "Derived metric calculated from simulation results.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "formula": {
          "description": "Formula name: 'psi_value', 'frsi', etc.",
          "title": "Formula",
          "type": "string"
        }
      },
      "required": [
        "name",
        "formula"
      ],
      "title": "DerivedMetric",
      "type": "object"
    },
    "ElementBase": {
      "additionalProperties": true,
      "description": "Base class for all geometry elements.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "default": "WALL",
          "description": "Material ID or Name",
          "title": "Material"
        },
        "lambda": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lambda"
        }
      },
      "required": [
        "type"
      ],
      "title": "ElementBase",
      "type": "object"
    },
    "MaterialDef": {
      "description": "Explicit material definition.",
      "properties": {
        "id": {
          "description": "Unique identifier for the material (e.g. 'WALL')",
          "title": "Id",
          "type": "string"
        },
        "lambda": {
          "description": "Thermal conductivity in W/(m*K)",
          "title": "Lambda",
          "type": "number"
        },
        "color": {
          "default": "#808080",
          "description": "Hex color for visualization",
          "title": "Color",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "solver_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solver Id"
        }
      },
      "required": [
        "id",
        "lambda"
      ],
      "title": "MaterialDef",
      "type": "object"
    },
    "MeasurementsConfig": {
      "description": "Configuration for measurements to extract from simulation.",
      "properties": {
        "point_probes": {
          "items": {
            "$ref": "#/$defs/PointProbe"
          },
          "title": "Point Probes",
          "type": "array"
        },
        "surface_metrics": {
          "items": {
            "$ref": "#/$defs/SurfaceMetric"
          },
          "title": "Surface Metrics",
          "type": "array"
        },
        "derived": {
          "items": {
            "$ref": "#/$defs/DerivedMetric"
          },
          "title": "Derived",
          "type": "array"
        }
      },
      "title": "MeasurementsConfig",
      "type": "object"
    },
    "PointProbe": {
      "description": "Point probe for temperature measurement.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "tolerance": {
          "default": 0.5,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ],
      "title": "PointProbe",
      "type": "object"
    },
    "SurfaceMetric": {
      "description": "Surface metric (min/max/avg temperature on boundaries).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "min",
            "max",
            "avg"
          ],
          "title": "Type",
          "type": "string"
        },
        "boundary": {
          "enum": [
            "internal",
            "external"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "materials": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Materials"
        }
      },
      "required": [
        "name",
        "type",
        "boundary"
      ],
      "title": "SurfaceMetric",
      "type": "object"
    },
    "TransientConfig": {
      "description": "Configuration for transient (time-dependent) simulation.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "duration_hours": {
          "default": 24.0,
          "description": "Simulation duration in hours",
          "title": "Duration Hours",
          "type": "number"
        },
        "dt_seconds": {
          "default": 300.0,
          "description": "Time step in seconds",
          "title": "Dt Seconds",
          "type": "number"
        },
        "initial_temp": {
          "default": 20.0,
          "description": "Initial uniform temperature",
          "title": "Initial Temp",
          "type": "number"
        },
        "save_interval_steps": {
          "default": 1,
          "description": "Save result every N steps",
          "title": "Save Interval Steps",
          "type": "integer"
        }
      },
      "title": "TransientConfig",
      "type": "object"
    }
  },
  "description": "Configuration schema for thermal bridge simulations. Defines geometry, materials, boundary conditions, and measurement specifications.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Schema version for migration support",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "description": "Human-readable scenario name",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detailed description",
      "title": "Description"
    },
    "variables": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Variables",
      "type": "object"
    },
    "materials": {
      "items": {
        "$ref": "#/$defs/MaterialDef"
      },
      "title": "Materials",
      "type": "array"
    },
    "definitions": {
      "additionalProperties": {
        "$ref": "#/$defs/ComponentDefinition"
      },
      "title": "Definitions",
      "type": "object"
    },
    "canvas": {
      "$ref": "#/$defs/CanvasConfig",
      "description": "Simulation canvas bounds and grid"
    },
    "points": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "type": "array"
      },
      "description": "Named points for polygon construction",
      "title": "Points",
      "type": "object"
    },
    "elements": {
      "description": "Geometry elements (rect, wall, polygon, window_detail, etc.)",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Elements",
      "type": "array"
    },
    "measurements": {
      "$ref": "#/$defs/MeasurementsConfig"
    },
    "boundary_conditions": {
      "$ref": "#/$defs/BoundaryConditions"
    },
    "transient": {
      "$ref": "#/$defs/TransientConfig"
    }
  },
  "required": [
    "name",
    "canvas",
    "elements"
  ],
  "title": "Thermal Bridge Scenario",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}